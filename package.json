{
  "name": "outmap",
  "productName": "Outmap",
  "version": "1.2.15",
  "description": "Outmap - High Performance 3D Outdoor Terrain GIS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:x64": "electron-packager . Outmap --platform=win32 --arch=x64 --out=dist --overwrite --icon=build/icon.ico --ignore=dist",
    "dist:x64": "electron-builder --win dir zip --x64",
    "dist:setup": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:all": "electron-builder --win dir zip nsis --x64"
  },
  "author": "Outmap Outdoor GIS Team",
  "license": "MIT",
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "pbf": "^5.1.2",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.outmap.outdoor3d",
    "productName": "Outmap",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Outmap 3D",
      "artifactName": "Outmap-Setup-${version}-x64.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!dist/**/*",
      "!offline-tiles/**/*",
      "!scripts/**/*"
    ],
    "asar": true
  }
}
