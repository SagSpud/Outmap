<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>11天西北自驾经典大环线(全程铺装·无越野SUV版)</name>
    <description>石家庄 → 库布其七星湖 → 乌海 → 银川贺兰山 → 青铜峡 → 中卫沙坡头/66号公路 → 靖边波浪谷 → 甘泉大峡谷 → 壶口瀑布 → 八泉峡 → 临沂</description>
    <Placemark>
      <name>石家庄南站</name>
      <description>起点：石家庄南站出发，纯赶路，夜宿杭锦旗/七星湖附近</description>
      <Point><coordinates>114.484800,38.012500,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>库布其七星湖</name>
      <description>七星湖沙漠生态公园，普通私家车走景区铺装道路与停车场，观沙漠湖泊</description>
      <Point><coordinates>108.384200,40.407600,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>乌海湖</name>
      <description>乌海湖生态旅游区，沙海相连，傍晚看乌海湖绝美落日</description>
      <Point><coordinates>106.772500,39.668800,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>贺兰山岩画</name>
      <description>一路南下，探访贺兰山岩画，山谷荒漠与古人类游牧文化遗迹</description>
      <Point><coordinates>105.992800,38.746500,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>西夏陵(银川)</name>
      <description>西夏陵国家考古遗址公园，神秘西夏王朝，市区休整调整节奏</description>
      <Point><coordinates>105.987500,38.431200,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>青铜峡黄河大峡谷</name>
      <description>黄河穿峡+青铜峡水利枢纽+108古塔群，黄河上游峡谷地貌</description>
      <Point><coordinates>105.986200,37.886000,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>中卫沙坡头</name>
      <description>上午沙坡头景区黄河与沙漠交汇，下午跑66号公路赶傍晚光线</description>
      <Point><coordinates>105.011800,37.458200,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>中卫66号公路</name>
      <description>中卫66号公路，黄河古村北长滩段，西北自驾大片取景地</description>
      <Point><coordinates>104.912500,37.382000,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>靖边波浪谷</name>
      <description>陕北靖边波浪谷（龙洲丹霞），留足整整一天细细游览时光纹理</description>
      <Point><coordinates>108.975400,37.491600,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>甘泉大峡谷</name>
      <description>中国羚羊谷，中午前后光线直射峡谷缝隙看奇幻光影</description>
      <Point><coordinates>109.176500,36.368200,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>黄河壶口瀑布</name>
      <description>上午壶口瀑布看千里黄河一壶收，奔腾咆哮，下午跨黄河进入山西</description>
      <Point><coordinates>110.443500,36.146800,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>太行山八泉峡</name>
      <description>太行山大峡谷八泉峡，早7:30首批入园游览峡谷绝壁，下午返程</description>
      <Point><coordinates>113.518600,35.918400,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>临沂</name>
      <description>终点：平安抵达临沂市，圆满结束11天西北自驾大环线</description>
      <Point><coordinates>118.356200,35.045800,0</coordinates></Point>
    </Placemark>
    <Placemark>
