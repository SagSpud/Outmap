<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Outmap 3D GIS" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>11天西北自驾经典大环线(全程铺装·无越野SUV版)</name>
    <desc>石家庄 → 库布其七星湖 → 乌海 → 银川贺兰山 → 青铜峡 → 中卫沙坡头/66号公路 → 靖边波浪谷 → 甘泉大峡谷 → 壶口瀑布 → 八泉峡 → 临沂</desc>
    <time>2026-09-09T14:07:46.628Z</time>
  </metadata>

  <wpt lat="38.012500" lon="114.484800">
    <name>石家庄南站</name>
    <desc>起点：石家庄南站出发，纯赶路，夜宿杭锦旗/七星湖附近</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="40.407600" lon="108.384200">
    <name>库布其七星湖</name>
    <desc>七星湖沙漠生态公园，普通私家车走景区铺装道路与停车场，观沙漠湖泊</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="39.668800" lon="106.772500">
    <name>乌海湖</name>
    <desc>乌海湖生态旅游区，沙海相连，傍晚看乌海湖绝美落日</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="38.746500" lon="105.992800">
    <name>贺兰山岩画</name>
    <desc>一路南下，探访贺兰山岩画，山谷荒漠与古人类游牧文化遗迹</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="38.431200" lon="105.987500">
    <name>西夏陵(银川)</name>
    <desc>西夏陵国家考古遗址公园，神秘西夏王朝，市区休整调整节奏</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="37.886000" lon="105.986200">
    <name>青铜峡黄河大峡谷</name>
    <desc>黄河穿峡+青铜峡水利枢纽+108古塔群，黄河上游峡谷地貌</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="37.458200" lon="105.011800">
    <name>中卫沙坡头</name>
    <desc>上午沙坡头景区黄河与沙漠交汇，下午跑66号公路赶傍晚光线</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="37.382000" lon="104.912500">
    <name>中卫66号公路</name>
    <desc>中卫66号公路，黄河古村北长滩段，西北自驾大片取景地</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="37.491600" lon="108.975400">
    <name>靖边波浪谷</name>
    <desc>陕北靖边波浪谷（龙洲丹霞），留足整整一天细细游览时光纹理</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="36.368200" lon="109.176500">
    <name>甘泉大峡谷</name>
    <desc>中国羚羊谷，中午前后光线直射峡谷缝隙看奇幻光影</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="36.146800" lon="110.443500">
    <name>黄河壶口瀑布</name>
    <desc>上午壶口瀑布看千里黄河一壶收，奔腾咆哮，下午跨黄河进入山西</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="35.918400" lon="113.518600">
    <name>太行山八泉峡</name>
    <desc>太行山大峡谷八泉峡，早7:30首批入园游览峡谷绝壁，下午返程</desc>
    <sym>Scenic Area</sym>
  </wpt>
  <wpt lat="35.045800" lon="118.356200">
    <name>临沂</name>
    <desc>终点：平安抵达临沂市，圆满结束11天西北自驾大环线</desc>
    <sym>Scenic Area</sym>
  </wpt>

